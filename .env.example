# CogniFlow OS Configuration Template
# Copy this file to .env and configure your keys.

APP_NAME=cogniflow-os
HOST=127.0.0.1
PORT=8765

# -----------------------------------------------------------------------------
# AI MODEL CASCADE PRIORITY
# 1. AWS Bedrock -> 2. Groq Cloud -> 3. Google Gemini -> 4. Local SQLite Failsafe
# -----------------------------------------------------------------------------

# Priority 1: AWS Bedrock (Anthropic Claude 3.5 / 4.5 Sonnet)
AWS_REGION=us-east-1
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
LEAD_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
SPECIALIST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Priority 2: Groq Cloud (Free Tier, ~300 tok/s)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_DAILY_TOKEN_LIMIT=500000

# Priority 3: Google Gemini (Free Tier, 1M Context Window)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DAILY_TOKEN_LIMIT=1000000

# Academic Platform Configuration
NTULEARN_BASE_URL=https://ntulearn.ntu.edu.sg/
